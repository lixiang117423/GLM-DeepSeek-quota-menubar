<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template: __PYTHON__ and __SCRIPT_DIR__ are replaced by run.sh --install
  with absolute paths local to this machine (launchd does not expand ~ or $VAR).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lixiang.glm-quota-menubar</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__SCRIPT_DIR__/glm_quota_menubar.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__SCRIPT_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart only on a crash (non-zero / abnormal exit). Quitting from the
         menu is a clean exit, so launchd will NOT relaunch it. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>/tmp/glm-quota-menubar.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/glm-quota-menubar.log</string>
</dict>
</plist>
